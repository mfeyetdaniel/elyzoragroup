# ─────────────────────────────────────────────────────────────
#  ÉLYSORA Group — variables d'environnement
#  Copier ce fichier en .env.local pour travailler en local.
#  En production : Netlify › Site configuration › Environment variables
#  NE JAMAIS mettre de vraies clés dans Git.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings › Data API) — publiques
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SECRÈTE (serveur uniquement, jamais NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (SECRÈTES) — Developers › API keys (sk_test_… en mode test)
STRIPE_SECRET_KEY=
# Developers › Webhooks › point de terminaison /api/stripe/webhook › Signing secret
STRIPE_WEBHOOK_SECRET=
# "true" une fois Stripe Tax configuré (adresse d'origine + inscriptions TPS/TVQ)
STRIPE_TAX_AUTOMATIQUE=false

# Phase 5 — Resend (SECRÈTE)
RESEND_API_KEY=
EMAIL_EXPEDITEUR="ÉLYSORA Group <commandes@votre-domaine.ca>"
EMAIL_ADMIN=
